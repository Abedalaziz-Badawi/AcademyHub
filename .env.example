DB_HOST=localhost
DB_PORT=5432
DB_NAME=academyhub
DB_USER=postgres
DB_PASSWORD=your_postgres_password
PORT=3000
NODE_ENV=development

# AUTH_SECRET signs login tokens and is always required (32+ characters).
# Quote any value containing # or other special characters, otherwise
# dotenv treats everything after # as a comment and silently truncates it.
AUTH_SECRET="change_me_to_a_random_string_at_least_32_characters_long"

# ADMIN_USERNAME/ADMIN_PASSWORD are only used once, to create the first
# Admin account in the staff_users table when it's empty. After that first
# login, add more accounts from the app's Staff page instead of editing
# these — they're ignored once at least one staff account exists.
ADMIN_USERNAME=Admin
ADMIN_PASSWORD="change_me"
