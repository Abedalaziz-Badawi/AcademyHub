DB_HOST=localhost
DB_PORT=5432
DB_NAME=academyhub
DB_USER=postgres
DB_PASSWORD=your_postgres_password
PORT=3000
NODE_ENV=development

# Admin login. Quote any value containing # or other special characters,
# otherwise dotenv treats everything after # as a comment and silently
# truncates it.
ADMIN_USERNAME=Admin
ADMIN_PASSWORD="change_me"
AUTH_SECRET="change_me_to_a_random_string_at_least_32_characters_long"
